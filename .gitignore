__pycache__/
*.pyc
node_modules/
app/dist/
.venv/
.DS_Store

# Die LoD2-Rohkacheln sind 43 MB CityGML und lassen sich jederzeit mit
# tools/fetch_lod2.py neu holen -- sie sind offene Geobasisdaten mit stabiler
# Adresse. Eingecheckt wird das Ergebnis: data/build/buildings.json und
# app/public/models/messe.glb. Damit bleibt der Bau reproduzierbar, ohne das
# Repository um ein Vielfaches seiner Groesse aufzublaehen.
data/raw/lod2/*.gml

# Ebenso die Orthophotos: 87 MB JPEG2000, aus denen eine 3,6-MB-Textur wird.
# Die Textur liegt im Repository, das Rohmaterial nicht.
data/raw/dop/*.jp2

# Der SLPK-Spike ist ein reproduzierbarer Abruf von rund 240 MB. Eingecheckt
# werden Herkunft und Inspektionsbericht, nicht das redundante Scene-Paket.
data/raw/slpk/*.slpk

# Kreisweites ALKIS-GPKG (537 MB) und Liefer-ZIP bleiben reproduzierbare
# Rohdownloads. Der Messe-Ausschnitt und der Audit sind kleine JSON-Dateien.
data/raw/alkis/*.gpkg
data/raw/alkis/*.zip

# Reproduzierbares, grosses Entwicklungsmodell. Der Builder und seine
# maschinenlesbaren GLB-Extras werden eingecheckt, nicht das Binaerprodukt.
data/build/official-world-diagnostic.glb
data/build/world-packages/**/*.glb
